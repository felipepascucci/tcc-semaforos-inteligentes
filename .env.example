# Modelo de variáveis de ambiente — context/02 §4.
# Copie para `.env` (que NUNCA é commitado) e ajuste ao seu ambiente.
#
#   Copy-Item .env.example .env

# --- Banco -----------------------------------------------------------------
# Credenciais usadas pelo serviço `db` do docker-compose.
POSTGRES_USER=tcc
POSTGRES_PASSWORD=senha
POSTGRES_DB=semaforo

# Perspectiva do HOST (`localhost`), como em context/02 §4 — é o que vale para
# alembic, db/seeds, sim/ e bridge/, que rodam fora do compose.
#
# Dentro do contêiner esta linha NÃO se aplica: o docker-compose.yml define
# DATABASE_URL no `environment:` do serviço `backend`, apontando para o host `db`
# da rede do Docker, e o `environment:` vence. O `.env` só alimenta a
# substituição de variáveis no próprio compose — ele não é injetado nos
# contêineres (não há `env_file:`).
DATABASE_URL=postgresql+psycopg://tcc:senha@localhost:5432/semaforo

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Login do operador do dashboard (context/02 §6, Bloco 7) ---------------
# Uma credencial só. A senha vai como hash PBKDF2, nunca em claro; gere um novo
# com `python -m app.services.autenticacao` (dentro do .venv, com backend/ no
# PYTHONPATH, ou `docker compose exec backend python -m app.services.autenticacao`).
# O hash abaixo é o da senha `operador`. SÓ PARA DESENVOLVIMENTO: troque o hash
# e o segredo antes da apresentação. Trocar o segredo derruba as sessões abertas.
OPERADOR_USUARIO=operador
OPERADOR_SENHA_HASH=pbkdf2_sha256:600000:65awAm2aT0qAXsGu_kbctw:YZXX7T2N8xDCvCnxMoPilTWOxpKrnItbJ9k4mWoq56E
# Pelo menos 32 caracteres; o backend não sobe com menos.
JWT_SEGREDO=dev-somente-local-troque-antes-da-apresentacao

# --- Perfil de parâmetros do motor de decisão ------------------------------
# "simulacao" -> backend/config/parametros.yaml          (dados estatísticos)
# "hardware"  -> + backend/config/parametros.hardware.yaml (bancada, ciclo 12 s)
PERFIL_PARAMETROS=simulacao

# --- SUMO (roda no host, fora do compose — context/02 §3) -----------------
SUMO_HOME=C:\Program Files (x86)\Eclipse\Sumo
SUMO_BINARY=sumo

# --- Ponte serial (roda no host, precisa de USB — context/02 §3) ----------
# O UNO, a 9600 baud: é a velocidade do NodeMCU receptor, que divide com o USB a
# única UART do UNO (context/05 §4).
SERIAL_PORT=COM3
SERIAL_BAUDRATE=9600
# O NodeMCU emissor, ligado ao USB só na medição de H3 (context/05 §4.3).
SERIAL_PORT_VEICULO=COM4
# API HTTP da própria ponte (/health, /estado, /injecao) — context/05 §6.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8001

# --- Backend <-> ponte e simulação (Bloco 6) -------------------------------
# O backend LÊ a ponte (GET /estado a 5 Hz); a ponte não sabe que ele existe.
# PONTE_URL é a perspectiva de quem roda o backend no HOST. Dentro do compose
# vale PONTE_URL_CONTEINER, que por padrão é http://host.docker.internal:8001.
# Deixe vazia para desligar a leitura.
PONTE_URL=http://localhost:8001
# PONTE_URL_CONTEINER=http://host.docker.internal:8001
# Para onde o executor (--transmitir) e o atendente de pedidos empurram o estado
# ao vivo da simulação.
BACKEND_URL=http://localhost:8000

# Sem Wi-Fi desde 2026-10-05: os NodeMCUs se falam por ESP-NOW e não acessam
# rede nem backend (context/02 §4).
