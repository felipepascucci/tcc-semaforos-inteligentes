# Modelo de variáveis de ambiente — context/02 §4.
# Copie para `.env` (que NUNCA é commitado) e ajuste ao seu ambiente.
#
#   Copy-Item .env.example .env

# --- Banco -----------------------------------------------------------------
# Credenciais usadas pelo serviço `db` do docker-compose.
POSTGRES_USER=tcc
POSTGRES_PASSWORD=senha
POSTGRES_DB=semaforo

# Visto de DENTRO do compose (host `db`). O backend usa esta.
DATABASE_URL=postgresql+psycopg://tcc:senha@db:5432/semaforo
# Visto do HOST (para alembic, sim/ e bridge/, que rodam fora do compose).
DATABASE_URL_HOST=postgresql+psycopg://tcc:senha@localhost:5432/semaforo

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Perfil de parâmetros do motor de decisão ------------------------------
# "simulacao" -> backend/config/parametros.yaml          (dados estatísticos)
# "hardware"  -> + backend/config/parametros.hardware.yaml (bancada, ciclo 24 s)
PERFIL_PARAMETROS=simulacao

# --- SUMO (roda no host, fora do compose — context/02 §3) -----------------
SUMO_HOME=C:\Program Files (x86)\Eclipse\Sumo
SUMO_BINARY=sumo

# --- Ponte serial (roda no host, precisa de USB — context/02 §3) ----------
SERIAL_PORT=COM3
SERIAL_BAUDRATE=115200

# --- Firmware --------------------------------------------------------------
# Consumidas por firmware/gerar_secrets.py para produzir secrets.h.
# O ESP8266 é 2,4 GHz apenas (context/02 §5).
WIFI_SSID=
WIFI_PASSWORD=
BACKEND_URL_DISPOSITIVO=http://192.168.0.10:8000
